{
  "name": "@jessevent/supalite-replica",
  "version": "0.1.0",
  "description": "Thin continuous SQLite replication + point-in-time restore for @supabase/lite, powered by an operator-installed Litestream.",
  "license": "MIT",
  "author": "Jesse Vent <16379819+JesseVent@users.noreply.github.com>",
  "homepage": "https://github.com/JesseVent/supalite-replica",
  "repository": {
    "type": "git",
    "url": "https://github.com/JesseVent/supalite-replica.git"
  },
  "bugs": "https://github.com/JesseVent/supalite-replica/issues",
  "keywords": [
    "sqlite",
    "litestream",
    "supabase",
    "supabase-lite",
    "replication",
    "backup",
    "restore",
    "wal",
    "point-in-time-recovery"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && vitest run"
  },
  "peerDependencies": {
    "@supabase/lite": ">=0.8.0 <0.9.0"
  },
  "devDependencies": {
    "@supabase/lite": "0.8.0",
    "@types/node": "22.20.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}